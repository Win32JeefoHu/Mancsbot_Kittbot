<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_kitt_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="K"
            android:textStyle="bold"
            android:textSize="21sp"
            android:textColor="#39E9FF"
            android:background="@drawable/widget_kitt_logo"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="9dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KITT AI · CONNECTING"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#F2F8FF"/>
            <TextView
                android:id="@+id/widget_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="PAPER MODE"
                android:textSize="9sp"
                android:textColor="#7EB8DE"/>
        </LinearLayout>
        <TextView
            android:id="@+id/widget_refresh"
            android:layout_width="42dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="↻"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#27F2AF"
            android:background="@drawable/widget_kitt_button"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:text="PORTFOLIO"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="8sp"
                android:textColor="#6484A7"/>
            <TextView
                android:id="@+id/widget_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="$0.00"
                android:textStyle="bold"
                android:textSize="23sp"
                android:textColor="#F2F8FF"/>
            <TextView
                android:id="@+id/widget_pnl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+0.00%"
                android:textStyle="bold"
                android:textSize="10sp"
                android:textColor="#27F2AF"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.18"
            android:orientation="horizontal"
            android:background="@drawable/widget_kitt_chip"
            android:padding="7dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:text="BTC" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textStyle="bold" android:textSize="8sp" android:textColor="#39E9FF"/>
                <TextView android:id="@+id/widget_btc" android:text="—" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textStyle="bold" android:textSize="10sp" android:textColor="#E9F7FF"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:text="ETH" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textStyle="bold" android:textSize="8sp" android:textColor="#A970FF"/>
                <TextView android:id="@+id/widget_eth" android:text="—" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textStyle="bold" android:textSize="10sp" android:textColor="#E9F7FF"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:text="SOL" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textStyle="bold" android:textSize="8sp" android:textColor="#E85CFF"/>
                <TextView android:id="@+id/widget_sol" android:text="—" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textStyle="bold" android:textSize="10sp" android:textColor="#E9F7FF"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_backend"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="● BACKEND CONNECTING"
            android:textSize="8sp"
            android:textColor="#27F2AF"/>
        <TextView
            android:id="@+id/widget_ai"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.35"
            android:gravity="end"
            android:text="AI LAB · WAITING"
            android:textSize="8sp"
            android:textColor="#C88AFF"/>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_open"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="OPEN KITT COMMAND CENTER"
        android:textStyle="bold"
        android:textSize="9sp"
        android:letterSpacing="0.08"
        android:textColor="#EAFBFF"
        android:background="@drawable/widget_kitt_button"/>
</LinearLayout>
